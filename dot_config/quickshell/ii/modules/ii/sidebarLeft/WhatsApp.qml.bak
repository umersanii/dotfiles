import QtQuick
import QtQuick.Controls
import QtQuick.Layouts
import qs.services
import qs.modules.common
import qs.modules.common.widgets
import Quickshell
import Quickshell.Io
import Quickshell.Hyprland

Item {
    id: root
    property bool windowOpen: false
    property int windowPid: 0

    Component.onCompleted: {
        console.log("WhatsApp component loaded")
    }

    Rectangle {
        anchors.fill: parent
        color: Appearance.colors.colLayer1

        ColumnLayout {
            anchors.centerIn: parent
            spacing: 16
            width: parent.width * 0.8

            StyledText {
                Layout.alignment: Qt.AlignHCenter
                text: Translation.tr("WhatsApp")
                font.pointSize: Appearance.font.pixelSize.large
                font.bold: true
            }

            StyledText {
                Layout.alignment: Qt.AlignHCenter
                Layout.fillWidth: true
                text: root.windowOpen 
                    ? Translation.tr("WhatsApp is running")
                    : Translation.tr("Opens WhatsApp Desktop")
                color: Appearance.colors.colSubtext
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
            }

            RippleButton {
                Layout.alignment: Qt.AlignHCenter
                colBackground: root.windowOpen ? Appearance.colors.colAccent : Appearance.colors.colLayer2
                
                contentItem: StyledText {
                    text: root.windowOpen 
                        ? Translation.tr("Close WhatsApp") 
                        : Translation.tr("Open WhatsApp")
                    horizontalAlignment: Text.AlignHCenter
                    verticalAlignment: Text.AlignVCenter
                }
                
                onClicked: {
                    if (root.windowOpen) {
                        Quickshell.run(["pkill", "-f", "whatsapp-linux-desktop"], {})
                        root.windowOpen = false
                        root.windowPid = 0
                    } else {
                        Quickshell.run(["/opt/WhatsApp Desktop/whatsapp-linux-desktop"], {})
                        root.windowOpen = true
                    }
                }
            }
        }
    }
}
